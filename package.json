{
  "name": "tsp-jules",
  "private": true,
  "version": "0.1.0-phase1",
  "description": "TSP-JULES executable architecture scaffold and governance-aligned platform foundation",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "vitest run",
    "lint": "turbo run lint",
    "typecheck": "tsc --noEmit",
    "clean": "turbo run clean",
    "format": "turbo run format",
    "test:architecture": "vitest run phase1-hardening.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.5.0",
    "turbo": "^2.10.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
