# Core runtime
NODE_ENV=development
PORT=3000
APP_NAME=tsp-jules

# Database
POSTGRES_DB=tsp_jules
POSTGRES_USER=tsp_jules
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://tsp_jules:change_me@postgres:5432/tsp_jules

# Redis
REDIS_URL=redis://redis:6379

# Backend API
BACKEND_PORT=3001
FRONTEND_PORT=3000
API_PREFIX=/api
API_VERSION=v1

# Security
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
SESSION_SECRET=replace_me

# Trading execution mode
TRADING_MODE=simulation
LIVE_TRADING=false
KILL_SWITCH=false

# Application
DEFAULT_TIMEFRAME=1h
DEFAULT_INSTRUMENT=EURUSD

# Observability
LOG_LEVEL=info
OTEL_SERVICE_NAME=tsp-jules

# External system placeholders
BROKER_API_KEY=
BROKER_API_SECRET=
