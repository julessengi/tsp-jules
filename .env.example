# Copy this file to .env and replace every REPLACE_* value.
NODE_ENV=development
PORT=3001
APP_NAME=tsp-jules
LOG_LEVEL=info
CORS_ORIGINS=

# Host-run API uses localhost; Compose injects the internal postgres service URL.
POSTGRES_DB=tsp_jules
POSTGRES_USER=tsp_jules
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgresql://tsp_jules:REPLACE_WITH_RANDOM_POSTGRES_PASSWORD@127.0.0.1:5432/tsp_jules?schema=public

# Redis
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_DIFFERENT_RANDOM_REDIS_PASSWORD@127.0.0.1:6379/0

# JWT — independent secret, minimum 32 characters
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_OF_AT_LEAST_48_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_ISSUER=tsp-jules
JWT_AUDIENCE=tsp-jules-api
REFRESH_TOKEN_TTL_DAYS=30

# Account provisioning — public registration remains disabled by default
ALLOW_PUBLIC_REGISTRATION=false
BOOTSTRAP_ADMIN_EMAIL=admin@tsp.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD_AT_LEAST_16_CHARACTERS

# Trading safety
TRADING_MODE=SIMULATION
LIVE_TRADING=false
KILL_SWITCH=false
