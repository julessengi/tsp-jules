{
  "name": "@tsp-jules/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run src",
    "prisma:generate": "node scripts/with-env.cjs prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "node scripts/with-env.cjs prisma validate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "node scripts/with-env.cjs prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "node scripts/with-env.cjs prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node scripts/with-env.cjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.19.1",
    "@types/passport-jwt": "4.0.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}